generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Setting {
  id                String   @id @default("main")
  siteTitle         String
  facebook          String   @default("")
  instagram         String   @default("")
  linkedin          String   @default("")
  twitter           String   @default("")
  youtube           String   @default("")
  whatsapp          String   @default("")
  externalNewsUrl     String @default("https://www.ozcankutlu.com/api/news")
  externalNewsLabel   String @default("Güncel Mali Gelişmeler")
  externalNewsEnabled Int    @default(1) // Ana sayfa haber şeridi açık mı (0/1)
  ga4MeasurementId    String @default("") // Google Analytics 4 Measurement ID (G-XXXX); boşsa yüklenmez

  aboutIntro          String @default("")
  aboutApproachTitle  String @default("Çalışma yaklaşımımız")
  aboutApproachText   String @default("")
  aboutScopeTitle     String @default("Kimlerle çalışıyoruz")
  aboutScopeText      String @default("")
  aboutPromiseTitle   String @default("Ne vaat ediyoruz")
  aboutPromiseText    String @default("")

  contactHeroTitle String @default("Birlikte planlayalım")
  contactHeroText  String @default("")
  contactEmail     String @default("info@ornek-mm.com")
  contactPhone     String @default("+90 (212) 000 00 00")
  contactAddress   String @default("İstanbul, Türkiye")
  contactHours     String @default("Hafta içi 09:00 – 18:00")
  contactMapEmbed  String @default("") // Google Haritalar embed src; boşsa harita yok
  servicesIntro    String @default("Standart hizmet paketimiz, mali müşavirlik ofisinizin temel ihtiyaçlarını kapsayacak şekilde hazırlanmıştır.")
  servicesProcess  String @default("")
  professionalInfo String @default("")
  kvkkInfo         String @default("")
  aboutPhoto       String @default("") // Hakkımda fotoğrafı: JSON {show, ext, v}
  siteLogo         String @default("") // Üst menü logosu: JSON {ext, version}
  heroDocs         String @default("") // Ana sayfa hero evrak yığını: JSON {sheets:[...]}
  portalEnabled    Int    @default(0) // Mükellef Köşesi açık mı (0/1)

  // Site başlığının (üst menü ve alt bilgi) görünümü. Boş yazı tipi = tema varsayılanı.
  titleFont  String @default("") // src/lib/title-fonts.ts içindeki anahtarlardan biri
  titleScale Int    @default(100) // varsayılan boyutun yüzdesi (70–150)

  // Ana sayfa hero + üst menü / alt bilgi CTA metinleri (Admin > Ayarlar).
  homeHeroTitle         String @default("Vergi ve muhasebede net, güvenilir rehberlik")
  homeHeroText          String @default("Şirketinizin yükümlülüklerini zamanında yönetir, kararlarınızı mali görünürlükle güçlendiririz.")
  homeHeroPrimaryCta    String @default("Görüşme Talep Et")
  homeHeroSecondaryCta  String @default("Hizmetleri İncele")
  headerCtaLabel        String @default("Randevu Alın")
  footerCtaTitle        String @default("İhtiyacınızı birlikte netleştirelim")
  footerCtaText         String @default("Kısa bir ön görüşmeyle başlayalım; kapsamı ve süreci birlikte belirleriz.")
  footerCtaButton       String @default("Görüşme Talep Et")

  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  viewCount Int      @default(0) // Yayındaki yazı sayfası görüntülenmesi (yaklaşık)

  // Sonradan eklenen alanlar (ham SQL ile okunup yazılır).
  seoTitle       String @default("") // boşsa başlık kullanılır
  seoDescription String @default("") // boşsa özet kullanılır
  slugHistory    String @default("") // eski adresler (JSON dizi); eski adres yeniye yönlenir
  publishedAt    String @default("") // ilk yayın tarihi (ISO metin); boşsa createdAt
  authorName     String @default("") // boşsa yazar olarak ofis adı kullanılır
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- Mükellef Köşesi ----------------------------------------------------------------
// Bu tablolar `prisma db push` ile oluşturulur; src/lib/portal-db.ts bunları ham SQL ile
// okur/yazar. Tarihler ISO metin, tutarlar tam sayı kuruştur. İlişkiler bilinçli olarak
// tanımlanmamıştır (silme işlemleri uygulama kodunda yapılır).

model Mukellef {
  id           String @id
  name         String
  email        String @unique // küçük harfe çevrilmiş
  passwordHash String @default("") // boşsa davet henüz kabul edilmemiş
  active       Int    @default(1)
  note         String @default("")
  createdAt    String
  lastLoginAt  String @default("")
}

model PortalToken {
  id        String @id
  mukellefId  String
  tokenHash String @unique // jetonun SHA-256 özeti; jetonun kendisi saklanmaz
  purpose   String // invite | reset
  expiresAt String
  usedAt    String @default("")
  createdAt String

  @@index([mukellefId])
}

model PortalFile {
  id           String @id
  mukellefId   String
  direction    String // from_mukellef | from_office
  title        String
  category     String
  period       String @default("") // YYYY-AA
  originalName String
  storedName   String // diskteki ad (rastgele); özgün ad yalnızca gösterim içindir
  size         Int
  requestId    String @default("")
  createdAt    String
  readAt       String @default("") // karşı tarafın ilk indirme/görüntüleme zamanı
  body         String @default("") // mesajın açıklama metni; ek yoksa storedName/originalName boştur
  hiddenByClientAt String @default("") // mükellef ofis mesajını kendi listesinden kaldırdıysa zamanı

  @@index([mukellefId])
}

model DocRequest {
  id          String @id
  mukellefId  String
  period      String
  title       String
  note        String @default("")
  status      String @default("open") // open | done
  createdAt   String
  fulfilledAt String @default("")

  @@index([mukellefId])
}

model LedgerEntry {
  id          String @id
  mukellefId  String
  entryDate   String // YYYY-AA-GG
  kind        String // charge (ücret/borç) | payment (ödeme)
  amountKurus Int
  description String
  createdAt   String

  @@index([mukellefId])
}
